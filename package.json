{
  "name": "pi-commandcode-provider",
  "version": "0.7.3-next.0",
  "description": "pi custom provider for Command Code API (commandcode.ai)",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "commandcode",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patlux/pi-commandcode-provider.git"
  },
  "homepage": "https://github.com/patlux/pi-commandcode-provider#readme",
  "bugs": {
    "url": "https://github.com/patlux/pi-commandcode-provider/issues"
  },
  "files": [
    "index.ts",
    "src/",
    "scripts/live-e2e-profile.mjs",
    "scripts/pi-authenticated.mjs",
    "scripts/pi-isolated.mjs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "RELEASE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run typecheck && npm run test:contracts:ts && node --test tests/test-release.mjs && tsx tests/test-package-manifest.ts && tsx tests/test-api-key.ts && tsx tests/test-pure-functions.ts && tsx tests/test-models.ts && tsx tests/test-model-metadata-check.ts && tsx tests/test-runtime.ts && tsx tests/test-pricing.ts && tsx tests/test-cost.ts && tsx tests/test-oauth.ts && tsx tests/test-abort.ts && tsx tests/test-overflow.ts && tsx tests/test-stream.ts && tsx tests/test-quota.ts && tsx tests/test-quota-command.ts && tsx tests/test-retry.ts && tsx tests/test-transport.ts && node tests/test-pi-isolated.mjs && node tests/test-pi-authenticated.mjs && node tests/test-pi-local.mjs && node tests/test-omp-compat.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check '**/*.{ts,mjs,json,md}'",
    "format": "prettier --write '**/*.{ts,mjs,json,md}'",
    "pi:isolated": "node scripts/pi-isolated.mjs",
    "pi:authenticated": "node scripts/pi-authenticated.mjs",
    "check:commandcode-catalog": "tsx .github/scripts/check-commandcode-model-metadata.ts command-code@latest",
    "sync:commandcode-catalog": "tsx .github/scripts/check-commandcode-model-metadata.ts command-code@latest --write",
    "test:quota": "tsx tests/test-quota.ts && tsx tests/test-quota-command.ts",
    "test:unit": "npm run test:contracts:ts && tsx tests/test-api-key.ts && tsx tests/test-pure-functions.ts && tsx tests/test-models.ts && tsx tests/test-model-metadata-check.ts && tsx tests/test-runtime.ts && tsx tests/test-pricing.ts && tsx tests/test-cost.ts && tsx tests/test-oauth.ts && tsx tests/test-abort.ts && tsx tests/test-overflow.ts && tsx tests/test-stream.ts && tsx tests/test-quota.ts && tsx tests/test-quota-command.ts && tsx tests/test-retry.ts && tsx tests/test-transport.ts",
    "test:api-key": "tsx tests/test-api-key.ts",
    "test:models": "tsx tests/test-models.ts && tsx tests/test-model-metadata-check.ts",
    "test:runtime": "tsx tests/test-runtime.ts",
    "test:pricing": "tsx tests/test-pricing.ts",
    "test:oauth": "tsx tests/test-oauth.ts",
    "test:abort": "tsx tests/test-abort.ts",
    "test:overflow": "tsx tests/test-overflow.ts",
    "test:stream": "tsx tests/test-stream.ts",
    "test:retry": "tsx tests/test-retry.ts",
    "test:transport": "tsx tests/test-transport.ts",
    "test:pi-isolated": "node tests/test-pi-isolated.mjs",
    "test:pi-authenticated": "node tests/test-pi-authenticated.mjs",
    "test:pi-local": "node tests/test-pi-local.mjs",
    "test:smoke": "node tests/test-smoke.mjs",
    "test:release": "node --test tests/test-release.mjs",
    "test:release-package": "node tests/test-release-package.mjs",
    "test:e2e:live": "node tests/test-live-e2e.mjs",
    "test:e2e:live:go": "node scripts/live-e2e-profile.mjs go",
    "test:e2e:live:goat": "node scripts/live-e2e-profile.mjs goat",
    "test:e2e:live:provider": "node scripts/live-e2e-profile.mjs provider",
    "test:e2e:live:all": "node scripts/live-e2e-profile.mjs go goat",
    "test:cost": "tsx tests/test-cost.ts",
    "test:contracts": "npm run test:contracts:ts && npm run test:contracts:go",
    "test:contracts:ts": "tsx tests/test-contracts.ts",
    "test:contracts:go": "cd packages/pig-commandcode-provider/extensions/pig-commandcode-provider && go test -race -run '^TestSharedContracts$' ./...",
    "generate:pig-catalog": "tsx scripts/generate-pig-catalog.ts",
    "check:pig-catalog": "tsx scripts/generate-pig-catalog.ts --check",
    "check:pig-sdk": "node scripts/check-pig-sdk.mjs",
    "test:pig-patches": "node --test tests/test-pig-patches.mjs",
    "test:pig": "cd packages/pig-commandcode-provider/extensions/pig-commandcode-provider && go vet ./... && go test -race ./...",
    "test:pig-local": "node tests/test-pig-local.mjs",
    "test:pig-state": "node tests/test-pig-state.mjs",
    "test:pig-login": "node tests/test-pig-login.mjs",
    "test:pig-live:go": "node tests/test-pig-live.mjs go",
    "test:pig-live:goat": "node tests/test-pig-live.mjs goat",
    "test:pig-live:provider": "node tests/test-pig-live.mjs provider",
    "test:pig-package": "node tests/test-pig-package.mjs",
    "test:pig-comparison": "node tests/test-pig-comparison.mjs",
    "benchmark:pig": "node tests/test-pig-comparison.mjs --benchmark"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "prettier": "^3.5.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
