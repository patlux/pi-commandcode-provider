+package agent
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/MichaelKinsy/PiG/ai"
+)
+
+func TestConvertToLLMDefersSignatureNormalizationToSelectedAPI(t *testing.T) {
+	// Pi's core/messages.ts convertToLlm retains assistant content. The API leaf's
+	// transformMessages decides replay validity, not the registered wrapper API.
+	for _, api := range []ai.API{ai.APIAnthropicMessages, ai.APIOpenAICompletions, ai.APIOpenAIResponses} {
+		t.Run(string(api), func(t *testing.T) {
+			content := []ai.AssistantContentBlock{
+				ai.ThinkingContent{Thinking: "reason", ThinkingSignature: "signed"},
+				ai.ThinkingContent{ThinkingSignature: "redacted", Redacted: true},
+				ai.TextContent{Text: "answer", TextSignature: "text-signature"},
+				ai.ToolCall{ID: "tool", Name: "read", Arguments: ai.JsonObject{}, ThoughtSignature: "tool-signature"},
+			}
+			message := &AssistantMessage{Role: RoleAssistant, Provider: "wrapped", ModelID: "model", API: api, Content: content, StopReason: ai.StopReasonToolUse}
+			target := &ai.Model{ID: "model", Provider: ai.NewOpenAIProvider(ai.OpenAIConfig{ProviderID: "wrapped", Model: "model"}), ProviderMeta: ai.ProviderMetadata{ProviderID: "wrapped", API: "wrapper-api"}}
+			converted := ConvertToLLM([]AgentMessage{{Assistant: message}}, target)
+			got := converted[0].(ai.AssistantMessage)
+			if !reflect.DeepEqual(got.Content, content) {
+				t.Fatalf("wrapper conversion changed signed content: %#v", got.Content)
+			}
+			leaf := *target
+			leaf.ProviderMeta.API = api
+			if replay := ai.TransformMessages(converted, &leaf, nil)[0].(ai.AssistantMessage); !reflect.DeepEqual(replay.Content, content) {
+				t.Fatalf("same API lost signatures: %#v", replay.Content)
+			}
+			leaf.ProviderMeta.ProviderID = "foreign"
+			replay := ai.TransformMessages(converted, &leaf, nil)[0].(ai.AssistantMessage)
+			for _, block := range replay.Content {
+				switch b := block.(type) {
+				case ai.ThinkingContent:
+					t.Fatal("foreign API kept thinking")
+				case ai.TextContent:
+					if b.TextSignature != "" {
+						t.Fatal("foreign API kept text signature")
+					}
+				case ai.ToolCall:
+					if b.ThoughtSignature != "" {
+						t.Fatal("foreign API kept tool signature")
+					}
+				}
+			}
+			if !reflect.DeepEqual(message.Content, content) {
+				t.Fatal("history mutated")
+			}
+		})
+	}
+}
